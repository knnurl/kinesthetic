     "\"leds\":" LEDS_JSON "}",
@@ -2205,6 +2207,8 @@ void sendTelemetry() {
     sgLoad, netMode.c_str(), netIp.c_str(), sliderPctForTele(), tofControl ? 1 : 0,
     filtDist, tofPresent ? 1 : 0, (unsigned)tofAddr, tofDir, tofEnabled ? 1 : 0, tofFarFast ? 1 : 0, tofMaxDist,
